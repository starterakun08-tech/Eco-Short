# ============================================================
#  EcoSort IoT Dashboard — Environment Variables Example
#  Salin file ini menjadi .env pada server hosting / Pterodactyl
# ============================================================

# Port server HTTP (Pterodactyl secara otomatis menyediakan variabel PORT)
PORT=40122

# Password awal akun Administrator saat database user masih kosong
# Jika dikosongkan, server akan membuat password acak sekali saat startup dan mencetaknya di console
ADMIN_PASSWORD=

# Token autentikasi rahasia untuk mikrokontroler ESP32
# Masukkan nilai acak unik, lalu salin nilai ini ke variabel DEVICE_TOKEN di file codeesp.py
DEVICE_TOKEN=isi_token_rahasia_esp32_disini

# Mode Demo (1 = Aktifkan tombol 'Muat Data Demo' di halaman Akun, 0 = Nonaktifkan)
DEMO_MODE=0

# Secret key untuk penandatanganan JWT sesi web (opsional, disarankan ganti di produksi)
JWT_SECRET=ecosort-super-secret-jwt-key-change-me

# API Key Google Gemini (opsional, untuk asisten AI cloud tingkat lanjut)
GEMINI_API_KEY=
