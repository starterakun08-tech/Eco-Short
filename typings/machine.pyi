from typing import Any

class Pin:
    IN: int = 0
    OUT: int = 1
    def __init__(self, pin: int, mode: int = 0, pull: int = -1) -> None: ...
    def value(self, val: int = ...) -> int: ...

class PWM:
    def __init__(self, pin: Pin, freq: int = 50, duty: int = 0) -> None: ...
    def duty_u16(self, duty: int) -> None: ...

def time_pulse_us(pin: Pin, pulse_level: int, timeout_us: int = 25000) -> int: ...
def reset() -> None: ...
